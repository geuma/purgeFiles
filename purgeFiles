import fnmatch
import getopt
import os
import shutil
import sys
import time


def main(argv):
    """Parse command-line arguments and start the purge operation."""

    # Set default behavior.
    force = False
    ages = None
    directory = None
    pattern = "*"

    try:
        opts, args = getopt.getopt(
            argv,
            "ha:d:p:f",
            [
                "help",
                "ages=",
                "directory=",
                "pattern=",
                "force",
            ],
        )

        if args:
            print(f"Ignoring arguments: {args}")

    except getopt.GetoptError as err:
        print(err, file=sys.stderr)
        usage(exit_code=2)

    for opt, arg in opts:
        if opt in ("-h", "--help"):
            usage(exit_code=0)

        elif opt in ("-d", "--directory"):
            directory = arg

        elif opt in ("-p", "--pattern"):
            pattern = arg

        elif opt in ("-a", "--ages"):
            ages = arg

        elif opt in ("-f", "--force"):
            force = True

    if ages is None:
        print("filepurge: age must be specified using the -a option",
              file=sys.stderr)
        usage(exit_code=2)

    if directory is None:
        print("filepurge: directory must be specified using the -d option",
              file=sys.stderr)
        usage(exit_code=2)

    purge(directory, pattern, ages, force)


def usage(exit_code=2):
    """Print usage information and exit."""

    print("Usage: purgeFiles [OPTION]...")
    print(" -h, --help                    Print this help message")
    print(" -a, --ages=age1,age2          Desired ages to keep, in days")
    print(" -d, --directory=dir           Target directory")
    print(" -p, --pattern=pattern         File pattern to match")
    print(" -f, --force                   Delete files instead of simulating")
    print()
    print(
        'Example: purgeFiles --ages=1,2,4,40 '
        '--directory=/tmp --pattern="*.txt"'
    )
    print()
    print(
        "This keeps files matching *.txt that are approximately "
        "40, 4, 2 and 1 days old."
    )
    print(
        "Without --force, the program only simulates the deletion."
    )
    print()
    print("Original author: John Quinn")

    raise SystemExit(exit_code)


def check_backup_area(directory):
    """Check that the target directory exists and is accessible."""

    absolute_directory = os.path.abspath(directory)

    if not os.path.exists(absolute_directory):
        print(
            f"filepurge: directory does not exist: {absolute_directory}",
            file=sys.stderr,
        )
        raise SystemExit(2)

    if not os.path.isdir(absolute_directory):
        print(
            f"filepurge: target is not a directory: {absolute_directory}",
            file=sys.stderr,
        )
        raise SystemExit(2)

    if not os.access(absolute_directory, os.R_OK | os.W_OK):
        print(
            "filepurge: directory is not readable and writable: "
            f"{absolute_directory}",
            file=sys.stderr,
        )
        raise SystemExit(2)


def check_arguments(ages):
    """Validate the age argument and return the sorted list of ages."""

    clean, ages_list = parse_ages_argument(ages)

    if not clean:
        print(
            f"filepurge: invalid ages argument: {ages}",
            file=sys.stderr,
        )
        usage(exit_code=2)

    return ages_list


def parse_ages_argument(ages):
    """
    Parse the age argument.

    Return a reverse-chronological list of desired ages in days.
    """

    if not ages:
        return False, []

    ages_list = []
    age_strings = ages.split(",")

    for age_string in age_strings:
        age_string = age_string.strip()

        if not age_string.isdigit():
            return False, []

        age = int(age_string)

        if age < 0:
            return False, []

        ages_list.append(age)

    if not ages_list:
        return False, []

    # Remove duplicate ages and sort from oldest to newest.
    ages_list = sorted(set(ages_list), reverse=True)

    return True, ages_list


def get_sorted_directory_list(directory, pattern):
    """
    Return matching directory entries sorted by modification time.

    Each entry is represented as:
        (modification_time, full_path, base_name)
    """

    sorted_directory_list = []

    with os.scandir(directory) as entries:
        for entry in entries:
            if not fnmatch.fnmatch(entry.name, pattern):
                continue

            try:
                modification_time = entry.stat(follow_symlinks=False).st_mtime
            except FileNotFoundError:
                print(
                    f"{entry.name}: disappeared while scanning, skipping",
                    file=sys.stderr,
                )
                continue
            except OSError as err:
                print(
                    f"{entry.name}: cannot read metadata: {err}",
                    file=sys.stderr,
                )
                continue

            sorted_directory_list.append(
                (
                    modification_time,
                    entry.path,
                    entry.name,
                )
            )

    sorted_directory_list.sort(key=lambda item: item[0])

    return sorted_directory_list


def delete_file(file_entry, force):
    """Delete one file or directory, respecting simulation mode."""

    _, file_name, base_name = file_entry

    if not force:
        print(f"{base_name}: Flagged for deletion")
        return

    try:
        if os.path.islink(file_name):
            os.unlink(file_name)
            print(f"{base_name}: Deleted symbolic link")

        elif os.path.isdir(file_name):
            shutil.rmtree(file_name)
            print(f"{base_name}: Deleted folder")

        elif os.path.isfile(file_name):
            os.remove(file_name)
            print(f"{base_name}: Deleted")

        else:
            print(
                f"{base_name}: is not a file or folder, skipping",
                file=sys.stderr,
            )

    except OSError as err:
        print(
            f"{base_name}: deletion failed: {err}",
            file=sys.stderr,
        )
        raise


def convert_age_to_epoch(age):
    """Convert an age in days to an epoch timestamp."""

    return int(time.time()) - (age * 24 * 60 * 60)


def convert_epoch_to_age(age_epoch):
    """Convert an epoch timestamp to a whole number of days."""

    return (int(time.time()) - int(age_epoch)) // (24 * 60 * 60)


def purge(directory, pattern, ages, force):
    """Purge the specified directory according to the retention ages."""

    directory = os.path.abspath(directory)

    check_backup_area(directory)
    ages_list = check_arguments(ages)

    sorted_directory_list = get_sorted_directory_list(directory, pattern)

    print(
        f"Finding files matching pattern {pattern!r} "
        f"of ages {ages} in directory {directory}"
    )

    if not sorted_directory_list:
        print("No matching files found")
        return

    ages_iterator = iter(ages_list)
    current_desired_age = next(ages_iterator)
    completed_desired_ages = False

    for index, file_entry in enumerate(sorted_directory_list):
        current_desired_age_epoch = convert_age_to_epoch(
            current_desired_age
        )

        keeper = False
        file_age = file_entry[0]

        if index < len(sorted_directory_list) - 1:
            next_file = sorted_directory_list[index + 1]
            next_file_age = next_file[0]

            should_delete = (
                completed_desired_ages
                or (
                    file_age < current_desired_age_epoch
                    and next_file_age < current_desired_age_epoch
                )
            )

            if should_delete:
                delete_file(file_entry, force)
            else:
                keeper = True

        else:
            # Keep the newest remaining item while retention ages
            # are still being processed.
            if not completed_desired_ages:
                keeper = True
            else:
                delete_file(file_entry, force)

        if keeper:
            file_age_days = convert_epoch_to_age(file_age)

            print(
                f"{file_entry[2]}: keeping this item of age "
                f"{file_age_days} days to satisfy age "
                f"{current_desired_age} days"
            )

            try:
                current_desired_age = next(ages_iterator)
            except StopIteration:
                completed_desired_ages = True

    if not completed_desired_ages:
        while True:
            print(f"No file found to satisfy age {current_desired_age}")

            try:
                current_desired_age = next(ages_iterator)
            except StopIteration:
                break


if __name__ == "__main__":
    main(sys.argv[1:])